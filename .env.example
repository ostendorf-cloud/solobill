# Copy this file to .env and fill in real values before `docker compose up`.
# .env is gitignored (see .gitignore's "*.env" pattern); this file is not,
# and must never hold a value that would actually work anywhere.
#
# Every value below is read by docker-compose.yaml. See the comment on
# that file's postgres service for why there are two database passwords,
# not one.

# The bootstrap Postgres superuser's password. Used only by the "migrate"
# service to run db/migrations; cmd/solobill never connects with it.
# Generate a real one with:
#   openssl rand -hex 24
POSTGRES_SUPERUSER_PASSWORD=change-me-generate-with-openssl-rand-hex-24

# The restricted "solobill_app" role's password (NOSUPERUSER NOBYPASSRLS,
# created by docker/postgres/init-app-role.sh). This is the role
# cmd/solobill actually connects as. Must differ from
# POSTGRES_SUPERUSER_PASSWORD above. Generate a real one the same way:
#   openssl rand -hex 24
APP_DB_PASSWORD=change-me-generate-a-different-value-with-openssl-rand-hex-24

# HMAC signing keys, hex encoded, at least 32 bytes decoded
# (session.MinKeyBytes). Two different keys for two different purposes
# (internal/config's package doc explains why); generate each one with:
#   openssl rand -hex 32
#
# These placeholders are deliberately not valid hex, so internal/config.Load
# fails loudly (decodeHexKey: "must be hex encoded") instead of quietly
# accepting a key nobody generated.
SESSION_CODEC_KEY=generate-with-openssl-rand-hex-32
CSRF_KEY=generate-a-different-value-with-openssl-rand-hex-32

# The tenant cmd/solobill creates on startup if it does not exist yet, so
# there is something to log into right after `docker compose up --build`.
# Leave unset in any environment that is not this local compose setup;
# both are a no-op in production (internal/config.Config).
SEED_TENANT_SLUG=demo
SEED_TENANT_NAME=Demo Tenant
