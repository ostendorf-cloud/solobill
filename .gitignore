# macOS
.DS_Store

# Agents
.claude/settings.local.json
.claude/.cc-writes/
.claude/worktrees/

# Go
*.exe
*.test
*.out
*.prof
coverage.out
bin/

# Node, for the web/ and landing/ packages
node_modules/
.prerender-ssr/
dist/
coverage/
*.log
*.tsbuildinfo
.eslintcache

# pnpm puts its store inside the project when the global one is not writable,
# which is what a sandboxed run does.
.pnpm-store/

# Local secrets. .env.example stays tracked; nothing else named *.env does.
*.env

# Task's scratch directory. `task test:helm` builds a helm plugin directory here
# rather than relying on helm's own, which a cached tool install never populates.
.task/
