{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "solobill",
  "type": "object",
  "required": ["image", "service", "config", "existingSecret"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "resources": { "type": "object" },
    "startupProbe": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "config": {
      "type": "object",
      "required": ["listenAddr", "databaseUrl", "databaseUser"],
      "properties": {
        "listenAddr": { "type": "string", "minLength": 1 },
        "logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"]
        },
        "databaseUrl": {
          "type": "string",
          "minLength": 1,
          "description": "Credential-free Postgres connection URL (scheme, host, port, database, query parameters only). The role named by databaseUser MUST be NOSUPERUSER and NOBYPASSRLS: db/migrations relies on FORCE ROW LEVEL SECURITY for tenant isolation, which a superuser or BYPASSRLS role bypasses regardless of FORCE."
        },
        "databaseUser": {
          "type": "string",
          "minLength": 1,
          "description": "Postgres role solobill connects as. MUST be NOSUPERUSER and NOBYPASSRLS, provisioned that way by the cluster operator: a superuser or BYPASSRLS role bypasses every row-level-security policy this application depends on for tenant isolation, silently and regardless of FORCE ROW LEVEL SECURITY."
        },
        "sessionAllowPlainHttp": { "type": "boolean" },
        "allowedOrigins": {
          "type": "array",
          "items": { "type": "string" }
        },
        "trustedProxies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rateLimitBurst": { "type": "integer", "minimum": 1 },
        "rateLimitPer": { "type": "string", "minLength": 1 },
        "inviteDefaultTtl": { "type": "string", "minLength": 1 },
        "oidc": {
          "type": "object",
          "properties": {
            "issuerUrl": { "type": "string" },
            "clientId": { "type": "string" },
            "redirectUrl": { "type": "string" },
            "scopes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "defaultTenantSlug": { "type": "string" }
          }
        }
      }
    },
    "existingSecret": {
      "type": "object",
      "required": [
        "name",
        "databasePasswordKey",
        "sessionCodecKeyKey",
        "csrfKeyKey"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the existing Secret, created by the cluster's own secret manager operator, carrying every key below. This chart never creates this Secret from plaintext values."
        },
        "databasePasswordKey": {
          "type": "string",
          "minLength": 1,
          "description": "Key for DATABASE_PASSWORD. Required. The role this password authenticates MUST be NOSUPERUSER and NOBYPASSRLS; see config.databaseUser's own description."
        },
        "sessionCodecKeyKey": { "type": "string", "minLength": 1 },
        "csrfKeyKey": { "type": "string", "minLength": 1 },
        "oidcClientSecretKey": { "type": "string" }
      }
    },
    "migrationJob": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 }
          }
        },
        "annotations": { "type": "object" },
        "resources": { "type": "object" }
      }
    }
  }
}
